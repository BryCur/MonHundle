{
    "extends": "./tsconfig.app.json",
    "include": [
        "src/**/__tests__/*",
        "src/**/__integration-tests__/*",
        "test-utils/**/*",
        "env.d.ts"
    ],
    "exclude": [],
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",

        "lib": ["ES2022.Error"],
        "types": ["node", "jsdom"],
        "paths": {
            "@/*": ["./src/*"],
            "@test-utils/*": ["./test-utils/*"]
        }
    }
}
